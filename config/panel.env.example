# Copy to .private/<name>.env (e.g. .private/panel1.env) — one file per panel.
# Used by scripts/*.sh from your workstation:  scripts/install.sh panel1
PANEL_HOST=192.168.1.50
PANEL_USER=root
PANEL_PASSWORD=
# Optional: pin the panel's SSH host key (plink needs it), e.g. SHA256:xxxxxxxx
PANEL_HOSTKEY=
