# OPTIONAL per-panel settings. Copy to .private/<panel>.kiosk.env (e.g. .private/panel2.kiosk.env)
# only if this panel needs something different from .private/kiosk.env.
#
# Without this file the panel uses .private/kiosk.env (and its group file, if any) as is.
# With it, install.sh appends these lines after the shared settings, so anything here adds to or
# overrides them for THIS panel only. Use 0 to turn a shared feature off on this panel.
# Any setting from config/kiosk.env.example can go here.

# This panel's own wired light, room speakers and room lights
#LOAD_ENTITY=light.kitchen
#ROOM_SPEAKERS=media_player.kitchen
#ROOM_LIGHTS=light.kitchen,light.kitchen_island

# Opt-in features for this panel (all off unless turned on somewhere)
#KIOSK_VOICE=1
#KIOSK_INTERCOM=1
#INTERCOM_MIC=1
#KIOSK_CAPTURE=1

# Turn a shared feature off just here
#DOORBELL=0
#SECURITY_TAB=0

# Join a group (unit): also applies .private/<group>.group.env (see the manual, section 2.13)
#PANEL_GROUP=unit-2b
