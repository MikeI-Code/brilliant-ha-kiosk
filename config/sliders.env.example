# Physical slider strips, any gang count (local add-on settings; lives next to slider_worker.py
# as sliders.env). Strip 1 is the leftmost.
# Input slot of each strip, in strip order. On the panels tested, strips are slots 1, 2, 3.
SLIDER_SLOTS=1,2,3
# A strip can drive a wired load of this panel (named exactly as Brilliant shows it) ...
SLIDER_LOAD_1="Hallway"
# ... or a Home Assistant light (tap = on/off, slide = brightness). Use this for a switch that
# Brilliant runs always-on, where there is no wired dimmer to drive.
SLIDER_HA_2=light.living_room
# A wired load can sit on a different strip than its gang: here strip 3 drives gang 1.
#SLIDER_LOAD_3="Hallway"
#SLIDER_GANG_3=1
# With both LOAD and HA set, SLIDER_POWER_<n>=manage switches the load on before dimming the bulbs
# it feeds. The default, "leave", never touches the wired load.
SLIDER_HA_3=light.floor_lamp
