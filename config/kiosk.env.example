# Copied to /etc/ha-kiosk/kiosk.env on the panel.
# native = fast Qt UI (layout from LAYOUT_DASHBOARD or layout.json); web = HA's dashboard in a browser (slow on this CPU)
KIOSK_MODE=native
# Must be an address the panel can reach on the home LAN (not a Tailscale 100.x address).
# Native mode uses only the scheme/host/port; web mode loads the full URL.
HA_URL=http://192.168.1.10:8123/wall-panel/home
# Web mode only: page zoom. 2.0 makes the 720x1280 screen behave like a 360x640 phone.
HA_ZOOM=2.0

# Display schedule (24h, local time). Screen is off between these times; a touch wakes it.
SLEEP_START=21:00
SLEEP_END=06:30
# Backlight levels 0-15
DAY_LEVEL=15
DIM_LEVEL=4
# Seconds without a touch before the screensaver/dim (day) / going dark again after a wake (night)
IDLE_DIM_SECS=300
NIGHT_WAKE_SECS=180
# Daytime screensaver: 1 = slideshow of your Brilliant photos (plus /etc/ha-kiosk/photos), 0 = just dim
SCREENSAVER=1
# Show current weather (from the layout's weather entity) on the screensaver: 1 = yes, 0 = no
SCREENSAVER_WEATHER=1
PHOTO_LEVEL=12
# Seconds per photo
PHOTO_SECS=15
# Screensaver photos. Your own photos win: put them in .private/photos (copied by install.sh) and/or
# upload them in Home Assistant (Media -> My media), and only those are shown. With none, the
# Brilliant app's photos are used, then Brilliant's stock art.
#   HA_PHOTO_FOLDER  folder inside "My media" to sync (empty = all of My media, incl. subfolders)
#   PHOTO_SYNC_MINS  how often panels check HA for new/removed photos (0 = off)
#   PHOTO_DIRS       advanced: use exactly these panel folders instead of the above
HA_PHOTO_FOLDER=
PHOTO_SYNC_MINS=30
# Brilliant's preloaded stock art (used in place, never copied): fallback = only when there are no
# photos, mix = always add it to your photos, off = never
STOCK_ART=fallback
# POSIX TZ string (the panel's clock runs in UTC). Default is US Eastern with DST.
TZ_LOCAL=EST5EDT,M3.2.0,M11.1.0

# The HA long-lived token is NOT stored here: put it in /etc/ha-kiosk/token (chmod 600).
# Time zone for the dashboard clock (POSIX TZ string)
TZ=EST5EDT,M3.2.0,M11.1.0

# Native mode: build the screens from this HA dashboard (edit it in HA; panels update on save).
# Create it from a layout.json with scripts/publish_layout.py. Leave empty to use layout.json.
LAYOUT_DASHBOARD=panel-layout

# Wake the screen when someone walks up (faceplate motion sensor): day (default), always, off
MOTION_WAKE=day
# CPU governor while awake / screensaver or dim / night
CPU_AWAKE_GOV=performance
CPU_IDLE_GOV=schedutil
CPU_SLEEP_GOV=powersave
# Swap file in MB (the Brilliant kernel has no zram); 0 = none. Swappiness 10 = only under pressure.
SWAP_MB=256
SWAPPINESS=10

# Smart dimming (the panels have no usable light sensor): the screen follows the room's light level,
# estimated from the sun (sun.sun) and the room's lights in HA. Brightest of the two wins.
SMART_DIM=1
# Darkest awake level (dark room, lights off, after sunset)
MIN_LEVEL=5
# Sun elevation (degrees) mapped to "dark" and "full daylight"
SUN_DARK_ELEV=-4
SUN_BRIGHT_ELEV=10
AMBIENT_SECS=60
# Per panel, in .private/<panel>.kiosk.env (appended by install.sh):
#   ROOM_LIGHTS=light.kitchen_table,light.kitchen_island,switch.kitchen_fluorescents
# Optional real light sensor in the room (HA illuminance sensor, lux). Overrides the estimate when
# available. Usually per panel:  LIGHT_SENSOR=sensor.kitchen_motion_illuminance
#   LUX_DARK = lux at/below which the screen is at MIN_LEVEL; LUX_BRIGHT = lux for full brightness
LIGHT_SENSOR=
LUX_DARK=5
LUX_BRIGHT=300

# This panel's own wired load (per panel, in .private/<panel>.kiosk.env). Tiles for this entity are
# controlled locally through ha-kiosk-bridge (instant, works without HA), and gestures can drive it.
#   LOAD_ENTITY=light.kitchen_table
# This room's speakers (any HA media_player, per panel): three fingers up/down sets their volume.
#   ROOM_SPEAKERS=media_player.kitchen
# Multi-touch gestures (the screen tracks up to 10 fingers). Two fingers up/down dims LOAD_ENTITY
# unless GESTURE_2_SWIPE_UP/DOWN are set; three fingers up/down sets ROOM_SPEAKERS volume unless
# GESTURE_3_SWIPE_UP/DOWN are set. Actions: load.toggle | load.on | load.off | page:<n> |
# <domain>.<service>[:<entity_id>]   (e.g. scene.turn_on:scene.goodnight, light.turn_off:all)
GESTURE_2_TAP=load.toggle
GESTURE_3_TAP=
GESTURE_2_SWIPE_LEFT=
GESTURE_2_SWIPE_RIGHT=
GESTURE_3_SWIPE_LEFT=
GESTURE_3_SWIPE_RIGHT=

# ---- Home Assistant over MQTT (optional) -------------------------------------------------------
# Publishes each panel to HA with MQTT discovery: wired light, power, temperatures, motion, display
# state, screensaver/night/motion-wake/smart-dim switches, day brightness, wake button, gestures.
# Needs an MQTT broker connected to HA (e.g. the Mosquitto add-on). Leave MQTT_HOST empty to disable.
MQTT_HOST=
# Set KIOSK_MQTT=0 when another tool (e.g. brilliant-mqtt) already publishes this panel to HA.
KIOSK_MQTT=1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_BASE=brilliant_kiosk
MQTT_DISCOVERY_PREFIX=homeassistant
# Seconds the Motion sensor stays on after motion
MOTION_CLEAR_SECS=60
# Night schedule on/off (also switchable from HA)
NIGHT_MODE=1
# Seconds between polls of the read-only diagnostics (other loads' power, temperatures, firmware,
# HomeKit paired/enabled, Shelly BLE sensors, dimming calibration)
DIAG_SECS=60

# ---- Voice satellite and announcements (optional, uses the mic and speaker) --------------------
# Off by default. 1 = run ha-kiosk-voice: a Wyoming voice satellite for HA Assist on VOICE_PORT (bound
# to the panel's LAN address, only VOICE_ALLOW may connect), plus MQTT Talk / Announce / Speaker volume.
# Usually set per panel in .private/<panel>.kiosk.env. Leave it off on bedroom panels.
KIOSK_VOICE=0
VOICE_PORT=10700
# Name shown in HA's Wyoming integration
VOICE_NAME=
# ha = stream the mic to HA all the time for wake-word detection (needs a wake word engine in HA,
# e.g. the openWakeWord add-on); off = push-to-talk only (Talk button / automations)
VOICE_WAKE=off
# Hosts allowed to connect (comma-separated; default: the host in HA_URL). VOICE_BIND overrides the
# LAN address the port listens on (default: the address used to reach HA).
VOICE_ALLOW=
VOICE_BIND=
# Seconds to listen after Talk / a wake word before giving up
VOICE_LISTEN_SECS=15
# HA text-to-speech entity used for MQTT announcements of plain text
VOICE_TTS_ENGINE=tts.google_translate_en_com
# ALSA devices (shared with Brilliant). dmix_filtered follows Brilliant's volume (output_volume, the
# Speaker volume entity); "default" bypasses it and plays at full level.
VOICE_MIC=default
VOICE_SPEAKER=dmix_filtered

# ---- Intercom between panels (optional, audio only) --------------------------------------------
# Off by default. KIOSK_INTERCOM=1 = this panel can hear other panels (speaker only; needs MQTT,
# which is how panels find each other). INTERCOM_MIC=1 as well = this panel can also talk (mic):
# a hold-to-talk button in the panel UI and Intercom talk / target / test tone entities in HA.
# Set both per panel in .private/<panel>.kiosk.env; leave INTERCOM_MIC off on bedroom panels.
KIOSK_INTERCOM=0
INTERCOM_MIC=0
# UDP port for audio (RTP, 16 kHz PCM). Brilliant's firewall already accepts UDP 5000 and up.
# The panel UI talks to the service on 127.0.0.1, port INTERCOM_PORT + 1.
INTERCOM_PORT=10710
# Longest a single talk can last, seconds
INTERCOM_MAX_SECS=30
# ALSA devices (shared with Brilliant)
INTERCOM_MIC_DEVICE=default
INTERCOM_SPEAKER=dmix_filtered
# Address to send/receive on (default: the address used to reach MQTT_HOST)
INTERCOM_BIND=

# ---- Capture (optional): voice / video clips with a published API ------------------------------
# Off by default. KIOSK_CAPTURE=1 adds a "Capture" screen: a recording starts only when someone taps
# Record (or Home Assistant sends a record command) and the mic is closed right after. Each clip is
# announced over MQTT with a short-lived download URL; what happens next is up to your own HA
# automations (see MANUAL.md section 2.11). Nothing listens all the time.
KIOSK_CAPTURE=0
# 1 = also allow camera snapshots and short video clips (needs KIOSK_CAPTURE=1)
CAPTURE_VIDEO=0
# LAN port that serves clips; the panel UI uses CAPTURE_PORT + 1 on 127.0.0.1
CAPTURE_PORT=10720
# Hosts allowed to download clips (comma-separated; default: the host in HA_URL)
CAPTURE_ALLOW=
# Longest voice recording, seconds (video clips are always 10 s or less)
CAPTURE_MAX_SECS=30
# Seconds a clip stays downloadable before it is deleted
CAPTURE_TTL=300
# ALSA capture device (shared with Brilliant and the voice service)
CAPTURE_MIC=default
# 1 = also upload every clip into Home Assistant's media library (Media > My media) and add its
# media id to the event (media_id). Uses this panel's HA token, which must belong to an admin.
CAPTURE_UPLOAD=0
# Folder under /media to upload into (must already exist); empty = the top level
CAPTURE_UPLOAD_DIR=

# House thermostat controller (optional), e.g. a Flair "structure" that drives ecobee thermostats.
# Thermostat tiles then send mode and setpoint to it, and only the fan to the thermostat itself.
#CLIMATE_CONTROLLER=climate.my_home_structure
# Which climate entities are thermostats (default: those with fan modes)
#CLIMATE_THERMOSTATS=climate.main_floor,climate.upstairs

# ---- Groups and access (optional): multi-unit and rental properties ----------------------------
# Put these in a panel's .private/<panel>.kiosk.env (PANEL_GROUP) or in .private/<group>.group.env.
# Settings layers, later wins: kiosk.env -> <group>.group.env -> <panel>.kiosk.env.
# Group this panel belongs to (a-z, 0-9, -). Panels in a group share .private/<group>.group.env
# and only see each other on the intercom. Empty = no group.
#PANEL_GROUP=unit-2b
# Security tab on this panel: control (arm/disarm, lock/unlock), view (status only) or off (hidden)
#SECURITY_ACCESS=control
# Only these Ring/Schlage devices, by name (comma-separated, case-insensitive; empty = all).
# The word "alarm" includes the Ring Alarm.
#SECURITY_DEVICES=Front Door,Unit 2B Door
# Mic / camera locks: 0 blocks this project's voice, intercom mic and capture features.
# Deny wins: a 0 in ANY layer (property, group or panel) cannot be undone by another layer.
#ALLOW_MIC=1
#ALLOW_CAMERA=1
# Animated sky behind the clock on Home (beta): off | sky (still sky, ~4% CPU) | full (rain, snow,
# clouds; ~1 CPU core in bad weather, so the panel runs warm). Default full while in beta.
WEATHER_FX=sky
