pragma Singleton
// Material Design Icons (Pictogrammers): name -> glyph. The full map lives in icons.json
// (generated by tools/gen_icons.py), so any icon picked in HA's icon picker works.
import QtQuick 2.15

QtObject {
    readonly property var codes: load()
    function load() {
        var x = new XMLHttpRequest();
        try { x.open("GET", Qt.resolvedUrl("icons.json"), false); x.send(); return JSON.parse(x.responseText); }
        catch (e) { console.log("icons: cannot load icons.json: " + e); return {}; }
    }
    function glyph(name) {
        var c = codes[String(name).replace(/^mdi:/, "")];
        if (c === undefined) return "";
        c -= 0x10000;
        return String.fromCharCode(0xD800 + (c >> 10), 0xDC00 + (c & 0x3FF));
    }
}
